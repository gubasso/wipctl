{
  "markdown": {
    "lineWidth": 100,
    "textWrap": "never"
  },
  "includes": [
    "**/*.md",
    "**/*.markdown"
  ],
  // release-plz writes CHANGELOG.md and rk renders SECURITY.md whole, and sdd
  // renders the document templates and verifies their bytes, and rk and sdd
  // land the agent skills byte for byte, so each follows its generator.
  // Source: the dev-environment rule of nix-secrets
  // (home/apps/claude-session/rules/dev-environment.md).
  "excludes": [
    ".git",
    "node_modules",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/**/TEMPLATE-*.md",
    ".claude/skills/**",
    ".agents/skills/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm"
  ]
}
