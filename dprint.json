{
  "json": {
    "trailingCommas": "never"
  },
  "includes": ["**/*.{json,jsonc}"],
  "excludes": [
    ".git",
    "node_modules",
    "**/*-lock.json",
    "**/package-lock.json",
    "**/*.jsonl",
    // rk writes the landing record, sdd installs .spec-driven-docs/, and both
    // land the agent skills, so each follows its tool's form. Source: the
    // dev-environment rule of nix-secrets
    // (home/apps/claude-session/rules/dev-environment.md).
    ".release-kit/manifest.json",
    ".spec-driven-docs/**",
    ".claude/skills/rk-setup/**",
    ".claude/skills/rk-release/**",
    ".claude/skills/sdd-setup/**",
    ".claude/skills/sdd-write-docs/**",
    ".agents/skills/rk-setup/**",
    ".agents/skills/rk-release/**",
    ".agents/skills/sdd-setup/**",
    ".agents/skills/sdd-write-docs/**",
    "docs/.markdownlint-cli2.jsonc"
  ],
  "plugins": ["https://plugins.dprint.dev/json-0.23.0.wasm"]
}
