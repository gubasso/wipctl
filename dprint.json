{
  "json": {
    "trailingCommas": "never"
  },
  "includes": ["**/*.{json,jsonc}"],
  "excludes": [
    ".git",
    "node_modules",
    "**/*-lock.json",
    "**/package-lock.json",
    "**/*.jsonl",
    // rk writes the landing record, so it follows rk's form (the
    // generated-file rule of nix-secrets, ADR-0081).
    ".release-kit/manifest.json"
  ],
  "plugins": ["https://plugins.dprint.dev/json-0.23.0.wasm"]
}
