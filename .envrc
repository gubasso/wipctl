# shellcheck shell=bash
# nix-direnv is recommended for evaluation caching only. It is NOT required for
# GC safety: direnv's own `use_flake` runs `nix print-dev-env --profile
# "$(direnv_layout_dir)/flake-profile"`, and a Nix profile generation is a
# permanent GC root (`createGeneration` -> `addPermRoot`), so the devShell's
# store paths survive `nix-collect-garbage` either way.
use flake

# Per-checkout overrides and setup coordinates, gitignored. `source_env_if_exists`
# is direnv's own loader and is silent when the file is absent, so a fresh clone
# needs nothing.
source_env_if_exists .envrc.local

# Warn when a newer rk release is out. The check reads the network at most once
# a week, writes nothing but its cache, and exits 0. It moves no pin: the
# operator moves the pin from a shell, with the sync verb of rk.
rk self-depend check || true

# Warn when a newer sdd release is out, the same way. The operator moves the
# pin from a shell, with the sync verb of sdd.
sdd self-depend check || true

# Warn once a day about working-tree copies in the Nix store.
if command -v exobrain >/dev/null 2>&1; then exobrain store-guard --daily || true; fi
