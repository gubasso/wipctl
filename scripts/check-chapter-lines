#!/usr/bin/env bash
# Cap an explanation chapter and a guide at 200 lines
# (docs-format:chapter-stays-within-200-lines).
#
# The delivered chapter gate selects numbered method chapters, catalogs, and
# README files. This repository names its chapters for their subject, so that
# selector reaches none of them and the budget reads as gated while nothing
# decides it. This script closes that gap and selects nothing the delivered
# gate already covers.
#
# Specs carry their own 300-line cap and decision records carry a word cap, so
# neither is counted here.
set -euo pipefail

readonly cap=200
status=0

for file in "$@"; do
  [[ -f $file ]] || continue

  lines=$(wc -l <"$file")
  if ((lines > cap)); then
    printf '%s: %s lines, over the %s-line cap (docs-format:chapter-stays-within-200-lines)\n' \
      "$file" "$lines" "$cap" >&2
    status=1
  fi
done

if ((status != 0)); then
  printf '\nSplit the chapter at a subject boundary, or move the excess into a\n' >&2
  printf 'requirement in a spec or a decision record.\n' >&2
fi

exit "$status"
